#!/usr/bin/env bash
# Refuse un push direct vers main : tout changement passe par une branche et une PR.
#
# Activation, une fois par clone :   git config core.hooksPath .githooks
# Cas exceptionnel assumé :          AUTORISER_PUSH_MAIN=1 git push …
#
# GitHub Free ne protège pas main sur un dépôt privé : ce hook est le garde-fou local.
set -euo pipefail

[ "${AUTORISER_PUSH_MAIN:-}" = "1" ] && exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    cat >&2 <<'MSG'
✘ Push direct vers main refusé (voir CONTRIBUTING.md).

  git switch -c <type>/<description-courte>
  git push -u origin HEAD
  gh pr create --base main

Cas exceptionnel assumé : AUTORISER_PUSH_MAIN=1 git push …
MSG
    exit 1
  fi
done
exit 0
