{
  "description": "Garde-fou : bloque les commandes shell destructrices avant exécution",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/garde-fou.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
